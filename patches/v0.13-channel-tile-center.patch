+  function primeChannelTile(target) {
+    if (!target) return { ok: false, debug: 'no-tile' };
+    var r = rectOf(target);
+    if (!r) return { ok: false, debug: 'no-tile-rect' };
+    var x = (r.left + r.right) / 2, y = (r.top + r.bottom) / 2;
+    var fired = [];
+
+    // Orange reveals the centered Play control when the tile is hovered /
+    // focused. Do this BEFORE Android sends the real MotionEvent. React gets
+    // a complete hover transition and the following native tap lands in the
+    // exact same center where the Play overlay is rendered.
+    ['pointerover','pointerenter','mouseover','mouseenter','mousemove'].forEach(function (type) {
+      try { target.dispatchEvent(makeMouseEvent(type, x, y)); fired.push(type); } catch (_) {}
+    });
+    try {
+      var hadTabIndex = target.hasAttribute('tabindex');
+      var oldTabIndex = target.getAttribute('tabindex');
+      if (!hadTabIndex) target.setAttribute('tabindex', '-1');
+      if (typeof target.focus === 'function') {
+        try { target.focus({ preventScroll: true }); }
+        catch (_) { target.focus(); }
+      }
+      if (!hadTabIndex) target.removeAttribute('tabindex');
+      else target.setAttribute('tabindex', oldTabIndex);
+    } catch (_) {}
+
+    return { ok: true, x: x, y: y, debug: 'tile-center; hover=' + fired.join(',') };
+  }
